<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": KHÔNG reset bộ đếm mỗi lần -u (nếu không sẽ nhảy về 1 -> trùng mã) -->
    <data noupdate="1">

        <record id="seq_academy_helpdesk_ticket" model="ir.sequence">
            <field name="name">Academy Helpdesk Ticket</field>
            <field name="code">academy.helpdesk.ticket</field>
            <field name="prefix">TICKET/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>
