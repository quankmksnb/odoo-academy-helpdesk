<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_academy_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">academy.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- danh sách bảng -->
     <record id="view_academy_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">academy.helpdesk.ticket.list</field>
        <field name="model">academy.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="ticket_ref"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="customer_name"/>
                <field name="priority"/>
                <field name="is_urgent"/>
                <field name="channel"/>
                <field name="stage_id"/>
                <field name="date_deadline"/>
                <field name="days_open"/>
            </list>
        </field>
     </record>

     <!-- form detail ticket -->
      <record id="view_academy_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">academy.helpdesk.ticket.form</field>
        <field name="model">academy.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Agent nhận"
                    class="btn-primary" invisible="stage_code != 'new'"/>
                    <button name="action_wait" type="object" string="Chờ phản hồi"
                    invisible="stage_code != 'in_progress'"/>
                    <button name="action_customer_reply" type="object" string="KH phản hồi"
                    class="btn-primary" invisible="stage_code != 'waiting'"/>
                    <button name="action_close" type="object" string="Hoàn tất"
                    class="btn-primary" invisible="stage_code != 'in_progress'"/>
                    <field name="stage_id" widget="statusbar"
                    options="{'clickable': '0'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="ticket_ref"/>
                            <field name="priority"/>
                            <field name="is_urgent"/>
                            <field name="channel"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="customer_phone"/>
                            <field name="date_deadline"/>
                            <field name="days_open"/>
                            <field name="stage_code" invisible="1"/>
                            <field name="user_id"/>
                            <field name="assigned_date" readonly="1"/>
                            <field name="date_closed" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- search view -->
     <record id="view_academy_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">academy.helpdesk.ticket.search</field>
        <field name="model">academy.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_name"/>
                <filter name="urgent" string="Urgent"
                        domain="[('priority', '=', '3')]"/>
                <separator/>
                <filter name="group_channel" string="Channel"
                        context="{'group_by': 'channel'}"/>
            </search>
        </field>
     </record>
</odoo>
