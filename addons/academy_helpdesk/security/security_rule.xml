<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_ticket_user_own" model="ir.rule">
        <field name="name">Helpdesk User: own or unassigned tickets</field>
        <field name="model_id" ref="model_academy_helpdesk_ticket"/>
        <field name="domain_force">
            ['|', ('user_id', '=', user.id), ('user_id', '=', False)]
        </field>
        <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>

    <record id="rule_ticket_manager_all" model="ir.rule">
        <field name="name">Helpdesk Manager: all tickets</field>
        <field name="model_id" ref="model_academy_helpdesk_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
    </record>

</odoo>