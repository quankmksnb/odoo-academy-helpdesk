<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_academy_helpdesk" model="ir.module.category">
        <field name="name">Academy Helpdesk</field>
        <field name="sequence">20</field>
    </record>

    <!-- Privilege: tầng mới của Odoo 19, nối group với category -->
    <record id="res_groups_privilege_academy_helpdesk" model="res.groups.privilege">
        <field name="name">Academy Helpdesk</field>
        <field name="category_id" ref="module_category_academy_helpdesk"/>
        <field name="sequence">20</field>
    </record>

    <!-- Nhóm User -->
     <record id="group_helpdesk_user" model="res.groups">
        <field name="name">Helpdesk User</field>
        <field name="privilege_id" ref="res_groups_privilege_academy_helpdesk" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
     </record>

     <!-- Nhóm manager: kế thừa User + full quyền -->
      <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Helpdesk Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_academy_helpdesk" />
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
      </record>

      <!-- RECORD RULE: user chỉ thấy ticket của mình hoặc chưa gán -->
       <record id="rule_ticket_user_own" model="ir.rule">
            <field name="name">Helpdesk User: own or unassigned tickets</field>
            <field name="model_id" ref="model_academy_helpdesk_ticket"/>
            <field name="domain_force">
            ['|', ('user_id', '=', user.id), ('user_id', '=', False)]
            </field>
            <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
       </record>

       <!-- Manager thấy full -->
        <record id="rule_ticket_manager_all" model="ir.rule">
            <field name="name">Helpdesk Manager: all tickets</field>
            <field name="model_id" ref="model_academy_helpdesk_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
        </record>
</odoo>
